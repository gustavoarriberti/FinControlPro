# Banco de Dados Relacional (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/controle_financeiro?schema=public"

# Armazenamento de Arquivos (Supabase Storage / S3 / R2)
# Quando não configurado, o sistema salva automaticamente em public/uploads/
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET_INVOICES="invoices"
STORAGE_BUCKET_RECEIPTS="receipts"

# Extração Inteligente de Faturas em PDF (Google Gemini API)
# Quando não configurado, utiliza o extrator heurístico nativo para PDFs brasileiros
GEMINI_API_KEY=""

# Alertas de Vencimento por E-mail (Resend)
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="alertas@controlefinanceiro.local"
